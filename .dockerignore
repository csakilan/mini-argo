# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the status page sources, which are built inside the image.
# node_modules and dist are deliberately left out: the build produces its own.
!web
!web/dashboard
!web/dashboard/package.json
!web/dashboard/package-lock.json
!web/dashboard/vite.config.js
!web/dashboard/index.html
!web/dashboard/src
!web/dashboard/src/**
web/dashboard/node_modules
web/dashboard/dist
